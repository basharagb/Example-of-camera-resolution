<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- Direct LAN traffic never crosses the internet. Public traffic remains
         HTTPS-only through wavelive.duckdns.org. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.72</domain>
    </domain-config>
</network-security-config>
